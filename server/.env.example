JWT_SECRET=replace_with_random_secret
PORT=3001
# Comma-separated list of allowed origins for CORS (dev cross-origin only;
# production build is served same-origin and ignores this).
CORS_ORIGIN=http://localhost:5173
# Postgres connection string (e.g. Supabase's Session pooler URI).
# Leave unset for local SQLite.
DATABASE_URL=
